rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Oyuncu Kullanıcı Profili, Oyun Kaydı & Kişisel Betikler
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Benzersiz Mühendis İsimleri (Çağrı Kodları) İndeks Koleksiyonu
    match /display_names/{name} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // 3. Genel Topluluk C# Betikleri Pazarı (Marketplace)
    match /community_scripts/{scriptId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 4. Global Liderlik Tablosu
    match /leaderboards/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
